# STM32F407G-DISC1, F4BY hwdef'inden türetildi
MCU STM32F4xx STM32F407xx

# board_types.txt'te çakışmayan bir sayı seç
APJ_BOARD_ID 9999

FLASH_SIZE_KB 1024
OSCILLATOR_HZ 8000000
STM32_ST_USE_TIMER 5

# kullanıcı micro-USB'si (ST-LINK portu değil)
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9 VBUS INPUT OPENDRAIN

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

SERIAL_ORDER OTG1 USART2
PA2 USART2_TX USART2 NODMA
PA3 USART2_RX USART2

PA1 BATT_VOLTAGE_SENS ADC1 SCALE(2)

# hata sonrasi init storage 
define HAL_STORAGE_SIZE 15360
STORAGE_FLASH_PAGE 2
FLASH_RESERVE_START_KB 64

include ../include/minimize_features.inc
