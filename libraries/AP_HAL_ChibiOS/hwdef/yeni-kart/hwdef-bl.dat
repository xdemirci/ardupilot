MCU STM32F4xx STM32F407xx
APJ_BOARD_ID 9999            # ana hwdef ile aynı olmalı
OSCILLATOR_HZ 8000000
STM32_ST_USE_TIMER 5
FLASH_SIZE_KB 1024

SERIAL_ORDER OTG1 USART2

# Discovery LED'leri: PD12 yeşil, PD14 kırmızı
PD14 LED_BOOTLOADER OUTPUT
PD12 LED_ACTIVITY OUTPUT
define HAL_LED_ON 1

PA9 VBUS INPUT
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

PA2 USART2_TX USART2
PA3 USART2_RX USART2

FLASH_USE_MAX_KB 16
FLASH_RESERVE_START_KB 0

# öncesi 16 idi
FLASH_BOOTLOADER_LOAD_KB 64